<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fdhbankatmsimulator.BankFormPage2Controller">

    <!-- Image -->
    <ImageView fitHeight="100" fitWidth="100" layoutX="100" layoutY="20" preserveRatio="true">
        <image>
            <Image url="@icons/fdh.png" />
        </image>
    </ImageView>

    <Label layoutX="730" layoutY="10" text="PAGE 2" textFill="black">
        <font>
            <Font name="Raleway Bold" size="15" />
        </font>
    </Label>

    <Label layoutX="350" layoutY="100" text="Additional Details" textFill="black">
        <font>
            <Font name="Raleway Bold" size="20" />
        </font>
    </Label>

    <!-- Religion -->
    <Label layoutX="100" layoutY="150" text="Religion :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <ComboBox fx:id="religionBox" layoutX="350" layoutY="150" prefWidth="320" />

    <!-- Category -->
    <Label layoutX="100" layoutY="200" text="Category :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <ComboBox fx:id="categoryBox" layoutX="350" layoutY="200" prefWidth="320" />

    <!-- Income -->
    <Label layoutX="100" layoutY="250" text="Income :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <ComboBox fx:id="incomeBox" layoutX="350" layoutY="250" prefWidth="320" />

    <!-- Education -->
    <Label layoutX="100" layoutY="300" text="Education Qualification :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <ComboBox fx:id="educationBox" layoutX="350" layoutY="300" prefWidth="320" />

    <!-- Occupation -->
    <Label layoutX="100" layoutY="350" text="Occupation :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <ComboBox fx:id="occupationBox" layoutX="350" layoutY="350" prefWidth="320" />

    <!-- PAN -->
    <Label layoutX="100" layoutY="400" text="PAN Number :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <TextField fx:id="panField" layoutX="350" layoutY="400" prefWidth="320" />

    <!-- Senior Citizen -->
    <Label layoutX="100" layoutY="500" text="Senior Citizen :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <RadioButton fx:id="scYes" layoutX="350" layoutY="500" text="Yes">
      <toggleGroup>
         <ToggleGroup fx:id="seniorGroup" />
      </toggleGroup></RadioButton>
    <RadioButton fx:id="scNo" layoutX="460.0" layoutY="500.0" text="No" toggleGroup="$seniorGroup" />

    <!-- Existing Account -->
    <Label layoutX="100.0" layoutY="550.0" text="Existing Account :" textFill="black">
        <font>
            <Font name="Raleway Bold" size="18" />
        </font>
    </Label>
    <RadioButton fx:id="eaYes" layoutX="350.0" layoutY="550.0" text="Yes">
      <toggleGroup>
         <ToggleGroup fx:id="accountGroup" />
      </toggleGroup></RadioButton>
    <RadioButton fx:id="eaNo" layoutX="460.0" layoutY="550.0" text="No" toggleGroup="$accountGroup" />

    <!-- Submit -->
    <Button fx:id="submitBtn" layoutX="570" layoutY="640" onAction="#handleSubmit" prefHeight="35" prefWidth="100" style="-fx-background-color: blue; -fx-text-fill: gold; -fx-font-family: 'Raleway'; -fx-font-weight: bold;" text="Submit" />
</AnchorPane>

<BorderPane prefHeight="650.0" prefWidth="1305.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fdhbankatmsimulator.WithdrawMoneyController">

    <!-- LEFT PANE (ATM IMAGE + LOGIN FORM) -->
    <left>
        <StackPane fx:id="stackPane" prefHeight="659.0" prefWidth="920.0" style="-fx-background-color: #949191;">
            <!-- ATM Image that auto-resizes -->
            <ImageView fx:id="atmImage" fitHeight="659.0" fitWidth="920.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@icons/bg.png" />
            </ImageView>
            <AnchorPane prefHeight="658.0" prefWidth="920.0">
                <AnchorPane layoutX="151.0" layoutY="118.0" prefHeight="328.0" prefWidth="393.0" style="-fx-background-color: #949191;">
                    <ImageView fitHeight="57.0" fitWidth="80.0" layoutX="160.0" layoutY="31.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@icons/fdh2.png" />
                    </ImageView>
               <Label layoutX="115.0" layoutY="128.0" text="Withdraw">
                  <font>
                     <Font name="DejaVu Serif Bold" size="30.0" />
                  </font>
               </Label>
               <TextField fx:id="amountField" layoutX="8.0" layoutY="229.0" prefHeight="67.0" prefWidth="377.0" promptText="Enter Amount" style="-fx-padding: 8; -fx-text-fill: white; -fx-background-radius: 8; -fx-background-color: #434242; -fx-border-color: #283fbd; -fx-border-radius: 8;">
                  <font>
                     <Font size="16.0" />
                  </font>
               </TextField>
               <Label layoutX="91.0" layoutY="186.0" text="Enter multiples of K500">
                  <font>
                     <Font name="DejaVu Serif Bold" size="17.0" />
                  </font>
               </Label>
                </AnchorPane>
            </AnchorPane>
        </StackPane>
    </left>
    <right>


            <Button alignment="BOTTOM_CENTER" contentDisplay="BOTTOM" layoutX="223.0" layoutY="358.0" mnemonicParsing="false" onAction="#enterBtn" prefHeight="85.0" prefWidth="133.0" styleClass="button-enter" text="Enter">

            <Button fx:id="btnSeven" layoutX="8.0" layoutY="171.0" mnemonicParsing="false" onAction="#sevenBtn" prefHeight="77.0" prefWidth="60.0" style="-fx-background-color: #353434; -fx-text-fill: white; -fx-font-weight: bold;  -fx-border-radius: 8;" text="7">

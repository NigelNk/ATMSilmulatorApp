<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="564.0" prefWidth="888.0" spacing="20.0" style="-fx-background-color: white;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fdhbankatmsimulator.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="150.0" />
    </padding>

    <Label prefHeight="172.0" prefWidth="259.0">
        <graphic>
            <ImageView>
                <Image url="@icons/fdh.png" />
            </ImageView>
        </graphic>
    </Label>

    <Label text="FDH FINANCIAL HOLDINGS LIMITED" textFill="#585d5eed">
        <font>
            <Font name="FreeSerif Bold" size="24.0" />
        </font>
    </Label>

    <Button mnemonicParsing="false" onAction="#createAccount" prefHeight="79.0" prefWidth="611.0" styleClass="quick-btn" text="Create an Account" />
    <Button mnemonicParsing="false" onAction="#useATM" prefHeight="70.0" prefWidth="607.0" styleClass="quick-btn" text="Use ATM" />

    <!-- Spacer pushes the label down -->
    <Region VBox.vgrow="ALWAYS" />

    <Label alignment="BOTTOM_LEFT" text="© 2025 FDH Bank. All rights reserved." textFill="#585d5eed">
        <font>
            <Font name="FreeSerif Bold" size="24.0" />
        </font>
    </Label>
</VBox>
